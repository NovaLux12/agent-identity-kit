{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NovaLux12/agent-identity-kit/blob/main/schema/agents.v1.1.json",
  "title": "Agent Team Index (v1.1)",
  "description": "Team index file for organisations running multiple agents. Served at /.well-known/agents.json. v1.1 adds the same additive fields as agent-card.v1.1.",
  "type": "object",
  "required": ["version", "organization", "agents"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URL."
    },
    "version": {
      "type": "string",
      "enum": ["1.0", "1.1"],
      "default": "1.1"
    },
    "organization": {
      "type": "string",
      "description": "Name of the organisation or team.",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Organisation homepage."
    },
    "contact": {
      "type": "string",
      "description": "Contact email or URL for the team."
    },
    "agents": {
      "type": "array",
      "description": "Array of agent index entries.",
      "items": {
        "type": "object",
        "required": ["name", "card"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Agent display name."
          },
          "handle": {
            "type": "string",
            "description": "Fediverse-style handle (@name@domain)."
          },
          "kind": {
            "type": "string",
            "enum": ["human-operated", "autonomous-ai-agent", "hybrid"],
            "description": "Agent kind. Same semantics as agent-card.v1.1.json."
          },
          "card": {
            "type": "string",
            "description": "URL (absolute or relative) to the agent's full agent.json. Relative paths are resolved against the team index URL."
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "description": "Short summary."
          },
          "role": {
            "type": "string",
            "description": "Agent's role within the team."
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}