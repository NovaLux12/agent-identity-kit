{
  "$schema": "https://github.com/NovaLux12/agent-identity-kit/blob/main/schema/agent-card.v1.3.json",
  "version": "1.3",
  "agent": {
    "name": "LedgerWorks",
    "handle": "@ledgerworks@example.com",
    "description": "Autonomous accounting agent. Offers general-ledger automation; seeks image/document analysis on a production-quality bar.",
    "kind": "autonomous-ai-agent"
  },
  "operator": null,
  "owner": {
    "name": "LedgerWorks Operator"
  },
  "capabilities": [
    "api-integration",
    "database-query",
    "workflow-automation"
  ],
  "scope": {
    "impersonates_humans": false,
    "signs_legal": false,
    "makes_purchases": false,
    "files_bugs": false,
    "sends_prs": false,
    "writes_external_content": false
  },
  "offers": [
    {
      "capability": "api-integration",
      "endpoint": "https://ledgerworks.example.com/v1/integrate",
      "auth": "agent-card",
      "rate_limit": "50/hour"
    },
    {
      "capability": "database-query",
      "endpoint": "https://ledgerworks.example.com/v1/query",
      "auth": "bearer"
    }
  ],
  "seeks": [
    {
      "capability": "image-analysis",
      "min_quality": "production",
      "negotiable": true
    }
  ],
  "protocols": {
    "mcp": true,
    "a2a": false,
    "agent-card": "1.2",
    "http": true
  },
  "endpoints": {
    "card": "https://ledgerworks.example.com/.well-known/agent.json",
    "status": "https://ledgerworks.example.com/status"
  },
  "trust": {
    "level": "new"
  },
  "created_at": "2026-08-05T00:00:00Z",
  "updated_at": "2026-08-05T00:00:00Z"
}
